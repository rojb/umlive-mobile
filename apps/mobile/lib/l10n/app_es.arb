{
  "@@locale": "es",

  "appTitle": "UMLive Voice",
  "@appTitle": {
    "description": "App name. Shown in the Assistant app bar and used as the task-switcher title. Not a translatable word, but it still lives here because no user-facing string may be hard-coded in Dart."
  },

  "assistantGreeting": "Hola, soy UMLive Voice. Puedo trabajar con el backend por voz.",
  "@assistantGreeting": {
    "description": "First assistant turn, shown when the conversation area is empty. T3 replaces the capability sentence with one derived from the discovered schema; until then it states the intent only."
  },

  "captureUnavailableCaption": "El micrófono todavía no está disponible",
  "@captureUnavailableCaption": {
    "description": "Caption under the capture orb while the voice engine itself is not ready yet (still provisioning, or unavailable on this install). The recognizer readiness banner above already states the detailed reason; this caption only says the control cannot be used yet."
  },

  "captureOrbSemantics": "Control de captura de voz. El micrófono todavía no está disponible.",
  "@captureOrbSemantics": {
    "description": "Screen-reader label for the capture control while the voice engine is not ready. FR-MG03/FR-MG04: every control announces its own state, and the caption alone is not enough because the orb carries no text."
  },

  "captureIdleCaption": "Listo para escuchar",
  "@captureIdleCaption": {
    "description": "Caption under the capture orb once the engine is ready, the microphone permission is granted, and nothing is being captured yet."
  },

  "captureListeningCaption": "Escuchando…",
  "@captureListeningCaption": {
    "description": "Empty-state label of the live transcript while listening and no partial has arrived yet."
  },

  "captureOrbSemanticsReady": "Control de captura de voz. Listo para escuchar. Tocar para hablar.",
  "@captureOrbSemanticsReady": {
    "description": "Screen-reader label for the capture control when it is armed and idle."
  },

  "captureOrbSemanticsListening": "Control de captura de voz. Escuchando. Tocar de nuevo para detener.",
  "@captureOrbSemanticsListening": {
    "description": "Screen-reader label for the capture control while the microphone is open."
  },

  "captureOrbSemanticsPermissionNeeded": "Control de captura de voz. Se necesita el permiso del micrófono. Tocar para solicitarlo.",
  "@captureOrbSemanticsPermissionNeeded": {
    "description": "Screen-reader label for the capture control when the microphone permission has not been granted yet, or was denied but can still be requested again (FR-MB04)."
  },

  "captureOrbSemanticsPermissionBlocked": "Control de captura de voz. El micrófono está bloqueado para esta aplicación. Abrir los ajustes del sistema para habilitarlo.",
  "@captureOrbSemanticsPermissionBlocked": {
    "description": "Screen-reader label for the capture control once the microphone permission was permanently denied (FR-MB04)."
  },

  "microphonePermissionRationale": "UMLive Voice necesita acceso al micrófono para escuchar las indicaciones por voz. Tocar el micrófono para conceder el permiso.",
  "@microphonePermissionRationale": {
    "description": "The FR-MB04 explanation shown in writing before the microphone permission is requested, and spoken through VoiceController.speak at the moment the request is made. Also shown, unchanged, after an ordinary (non-permanent) denial, since it still describes what tapping again will do."
  },

  "microphonePermissionPermanentlyDeniedCaption": "El micrófono está bloqueado para esta aplicación y ya no se puede volver a pedir el permiso desde aquí. Se habilita desde los ajustes del sistema, o se escribe la indicación.",
  "@microphonePermissionPermanentlyDeniedCaption": {
    "description": "FR-MB04: shown once the microphone permission is permanently denied. States plainly that the app cannot ask again and names the two ways forward, including the text fallback (FR-MB06)."
  },

  "microphonePermissionOpenSettings": "Abrir ajustes del sistema",
  "@microphonePermissionOpenSettings": {
    "description": "Button shown alongside microphonePermissionPermanentlyDeniedCaption; opens this app's system settings page."
  },

  "microphoneCaptureFailedCaption": "No se pudo usar el micrófono en este momento. Se puede intentar de nuevo, o escribir la indicación.",
  "@microphoneCaptureFailedCaption": {
    "description": "Shown when starting capture fails for a reason other than the permission itself (e.g. the device refused to open the microphone), so the caption does not keep claiming the control is simply idle."
  },

  "textFallbackLabel": "Escribir la indicación",
  "@textFallbackLabel": {
    "description": "FR-MB06: label of the text field that is the typed equivalent of every voice action. Always available, including when the microphone permission is denied."
  },

  "textFallbackHint": "Por ejemplo: agregá a Juan Pérez como cliente",
  "@textFallbackHint": {
    "description": "Placeholder inside the text fallback field, echoing the register of the canonical §5.1 utterances. An example value, not copy to translate."
  },

  "textFallbackSend": "Enviar",
  "@textFallbackSend": {
    "description": "Tooltip and accessibility label of the text fallback's send action."
  },

  "connectTitle": "Conectar",
  "@connectTitle": {
    "description": "Title of the Connect screen."
  },

  "connectExplanation": "Todavía no hay ningún backend conectado",
  "@connectExplanation": {
    "description": "Headline of the Connect empty state. Also used by the Backend row of Settings, where it explains why the row leads to Connect."
  },

  "connectHelp": "La dirección del backend se ingresa una sola vez.",
  "@connectHelp": {
    "description": "Secondary line under the Connect headline. Impersonal on purpose: the copy is Bolivian-neutral, so it avoids tuteo and voseo."
  },

  "connectFieldLabel": "Dirección del backend",
  "@connectFieldLabel": {
    "description": "Visible label above the address field."
  },

  "connectFieldHint": "https://mi-backend.example.com",
  "@connectFieldHint": {
    "description": "Placeholder inside the address field. It is an example value, not copy to translate."
  },

  "queueTitle": "Cola",
  "@queueTitle": {
    "description": "Title of the Queue screen, and the tooltip of the queue action in the Assistant app bar."
  },

  "queueEmpty": "No hay nada en cola",
  "@queueEmpty": {
    "description": "Queue empty state. T18 keeps it as the whole empty screen: the UX spec's Queue Empty row is 'nothing at all', so an empty queue shows no controls and no headers."
  },

  "queueItemCreate": "Alta de {entity}",
  "@queueItemCreate": {
    "description": "T18, FR-MD07: what a queued create will do, in domain language. The queue is the operator's list of promises, not a developer's log, so no operation key and no path is ever shown. The entity is the registry's own word for the record. Impersonal register: no tuteo and no voseo.",
    "placeholders": {
      "entity": {
        "type": "String"
      }
    }
  },

  "queueItemDelete": "Borrado del registro {id} de {entity}",
  "@queueItemDelete": {
    "description": "T18, FR-MD07: what a queued delete will do, in domain language, naming the record it will remove so the operator knows which promise is pending. It says what the item will do, never how the backend is called. Impersonal register: no tuteo and no voseo.",
    "placeholders": {
      "id": {
        "type": "String"
      },
      "entity": {
        "type": "String"
      }
    }
  },

  "queueItemUnknown": "Operación pendiente",
  "@queueItemUnknown": {
    "description": "T18: the queued item whose operation no longer belongs to any entity of the current registry, so no domain word can be named for it. The honest generic form instead of a record name the registry cannot supply. Impersonal register: no tuteo and no voseo."
  },

  "queueStatusPending": "En cola",
  "@queueStatusPending": {
    "description": "T18: the item is persisted and has not been attempted yet. One of the three queue states, which are distinguishable by word and never by colour alone (FR-MG04)."
  },

  "queueStatusInFlight": "Enviando…",
  "@queueStatusInFlight": {
    "description": "T18: a drain has taken the item and is sending it right now. One of the three queue states, distinguishable by word rather than by colour."
  },

  "queueStatusFailed": "Falló",
  "@queueStatusFailed": {
    "description": "T18, FR-MD08: the last attempt failed and the item is still queued, retained for retry or cancellation. One of the three queue states, distinguishable by word rather than by colour."
  },

  "queueAttempts": "Intentos: {count}",
  "@queueAttempts": {
    "description": "T18: how many sends have failed so far, shown on the item only when it is greater than zero. It counts attempts, not taps: a retry that has not been attempted yet does not add one. Impersonal register: no tuteo and no voseo.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },

  "queueFailedNoAnswer": "El backend no respondió.",
  "@queueFailedNoAnswer": {
    "description": "T18, FR-MD08: the reason for a failed queue item when the backend gave no answer at all, derived from the stable code the drain persisted. The reason is said in domain language and never as a stored string. Impersonal register: no tuteo and no voseo."
  },

  "queueFailedStatus": "El backend respondió con el código {status}.",
  "@queueFailedStatus": {
    "description": "T18, FR-MD08: the reason for a failed queue item when the backend refused it with a status. The code is a protocol fact the operator needs in order to retry or discard; T22 replaces it with a sentence derived from the generated errors map. Impersonal register: no tuteo and no voseo.",
    "placeholders": {
      "status": {
        "type": "int"
      }
    }
  },

  "queueFailedRejected": "El backend rechazó la operación.",
  "@queueFailedRejected": {
    "description": "T18, FR-MD08: the reason for a failed queue item whose stored code is the bare `rejected` a row the drain (T16) wrote before T18 stored the status beside the code, so the status of the refusal is not in the row. It is deliberately vaguer than queueFailedStatus, which cannot be said here without inventing a code the row does not carry. Impersonal register: no tuteo and no voseo."
  },

  "queueFailedOrphan": "Esa operación ya no existe en el backend.",
  "@queueFailedOrphan": {
    "description": "T18, FR-MD08: the reason for a failed queue item whose operation the current registry no longer publishes, so it cannot be replayed. Impersonal register: no tuteo and no voseo."
  },

  "queueDiscard": "Descartar",
  "@queueDiscard": {
    "description": "T18, FR-MD07: the destructive action a swipe reveals on a queue item, and the confirm control in the confirmation that follows it. It never appears without that question behind it."
  },

  "queueDiscardAction": "Descartar del todo",
  "@queueDiscardAction": {
    "description": "T18, FR-MD07: the explicit discard control inside the item's card. A swipe alone is not discoverable and is impossible for some operators, so the same decision always has a visible control too. It is deliberately stronger wording than the swipe's revealed action, because it is what a tap does immediately."
  },

  "queueKeepAction": "Conservar",
  "@queueKeepAction": {
    "description": "T18: the non-destructive choice in the confirmation before a queue item is discarded. It keeps the promise the app made."
  },

  "queueCancelConfirmTitle": "¿Descartar la operación pendiente?",
  "@queueCancelConfirmTitle": {
    "description": "T18, FR-MD07: the question asked before a queued item is discarded, because a destructive action on a list is confirmed exactly as a destructive voice command is. Impersonal register: no second person, no tuteo and no voseo."
  },

  "queueCancelConfirmBody": "Se quitará de la cola y nunca se enviará.",
  "@queueCancelConfirmBody": {
    "description": "T18, FR-MD07: what discarding actually means — the promise is withdrawn and the command will never be sent. This is the one thing a discard must never blur. Impersonal register: no tuteo and no voseo."
  },

  "queueRetryAction": "Reintentar",
  "@queueRetryAction": {
    "description": "T18, FR-MD08: the retry control, offered on a failed queue item only and never on a pending one."
  },

  "settingsTitle": "Ajustes",
  "@settingsTitle": {
    "description": "Title of the Settings screen, and the tooltip of the settings action in the Assistant app bar."
  },

  "settingsLanguageLabel": "Idioma",
  "@settingsLanguageLabel": {
    "description": "Label of the locale row."
  },

  "settingsLanguageValue": "Español (es)",
  "@settingsLanguageValue": {
    "description": "Current, fixed locale. Locale is not a user choice at launch (UX spec, Pass 4 'Defaults introduced'), so this row is read-only."
  },

  "settingsTechnicalModeLabel": "Modo técnico",
  "@settingsTechnicalModeLabel": {
    "description": "Label of the technical-mode row (FR-ME06)."
  },

  "settingsTechnicalModeHelp": "Muestra el detalle técnico de cada turno.",
  "@settingsTechnicalModeHelp": {
    "description": "Explains what technical mode reveals. The switch is disabled until T23 wires it."
  },

  "settingsBackendLabel": "Backend",
  "@settingsBackendLabel": {
    "description": "Label of the row that navigates to the Connect screen."
  },

  "connectTokenLabel": "Token compartido (opcional)",
  "@connectTokenLabel": {
    "description": "Label of the bearer token field. It is only revealed behind the advanced affordance (UX spec, Pass 2: the token is secondary, needed once and typed rarely)."
  },

  "connectTokenHint": "Token del backend",
  "@connectTokenHint": {
    "description": "Placeholder inside the token field."
  },

  "connectTokenHelp": "Solo se necesita para los backends protegidos con token compartido. Se guarda cifrado en el teléfono.",
  "@connectTokenHelp": {
    "description": "Explains what the token is for and that it is stored encrypted at rest (FR-MA01)."
  },

  "connectAdvancedReveal": "Opciones avanzadas",
  "@connectAdvancedReveal": {
    "description": "Affordance that reveals the token field. Collapsed by default so the first launch asks for one thing only (UX spec, Pass 4)."
  },

  "connectAdvancedHide": "Ocultar opciones avanzadas",
  "@connectAdvancedHide": {
    "description": "Same affordance once the token field is visible."
  },

  "connectSubmit": "Conectar",
  "@connectSubmit": {
    "description": "The one action of the Connect screen: normalize, store and probe the address."
  },

  "connectProgress": "Buscando la API…",
  "@connectProgress": {
    "description": "Progress line of the Connection Loading state while the description path is being probed."
  },

  "connectLoadingEcho": "Dirección: {address}",
  "@connectLoadingEcho": {
    "description": "Echoes the address being probed, so the Loading state names what it is reaching.",
    "placeholders": {
      "address": {
        "type": "String"
      }
    }
  },

  "connectCancel": "Cancelar",
  "@connectCancel": {
    "description": "Cancels the probe in flight. The Connection Loading state must always offer it."
  },

  "connectCleartextWarning": "La conexión con {host} no está cifrada (HTTP). Se acepta porque la dirección es local o privada.",
  "@connectCleartextWarning": {
    "description": "Visible warning shown whenever a cleartext HTTP address is accepted (PRD-MOBILE.md §7, 'Security — transport'). It is never shown as a colour alone: it travels with a lock icon.",
    "placeholders": {
      "host": {
        "type": "String"
      }
    }
  },

  "addressProblemEmpty": "Ingrese la dirección del backend.",
  "@addressProblemEmpty": {
    "description": "Refusal when the address field is empty. Impersonal register, like the rest of the copy."
  },

  "addressProblemMalformed": "Escriba solo el host y, si hace falta, el puerto. Por ejemplo: https://mi-backend.example.com o 192.168.1.40:8080.",
  "@addressProblemMalformed": {
    "description": "Refusal when the text is not `host` or `host:port` after the scheme: it carries a path, a query or is not a URI authority at all."
  },

  "addressProblemUnsupportedScheme": "Solo se admiten direcciones http y https.",
  "@addressProblemUnsupportedScheme": {
    "description": "Refusal for any scheme other than http or https."
  },

  "addressProblemInvalidPort": "El puerto de la dirección no es válido.",
  "@addressProblemInvalidPort": {
    "description": "Refusal when a port is present but is not a number between 1 and 65535."
  },

  "addressProblemCleartextRefused": "No se acepta HTTP sin cifrado hacia una dirección pública: el tráfico viajaría sin protección. Use https, o una dirección local o privada.",
  "@addressProblemCleartextRefused": {
    "description": "Refusal of cleartext HTTP to a non-local host, stating why. The address is neither silently upgraded to https nor silently downgraded, so the sentence names the reason instead of a status."
  },

  "reachabilityProbingLabel": "Consultando",
  "@reachabilityProbingLabel": {
    "description": "Short label of the reachability indicator while a probe is in flight."
  },

  "reachabilityProbingSentence": "Se está consultando la descripción de la API del backend.",
  "@reachabilityProbingSentence": {
    "description": "Sentence of the reachability indicator while a probe is in flight."
  },

  "reachabilityNeverConnectedLabel": "Sin backend",
  "@reachabilityNeverConnectedLabel": {
    "description": "Reachability state: nothing configured yet (FR-MA05)."
  },

  "reachabilityNeverConnectedSentence": "Todavía no hay ningún backend conectado.",
  "@reachabilityNeverConnectedSentence": {
    "description": "Sentence of the never-connected reachability state."
  },

  "reachabilityConnectedLabel": "Conectado",
  "@reachabilityConnectedLabel": {
    "description": "Reachability state: 2xx from the description path."
  },

  "reachabilityConnectedSentence": "El backend respondió y publica su descripción de API.",
  "@reachabilityConnectedSentence": {
    "description": "Sentence of the connected reachability state. It says the backend answered, never that the radio is on (FR-MD01)."
  },

  "reachabilityMissingDescriptionLabel": "Sin descripción de API",
  "@reachabilityMissingDescriptionLabel": {
    "description": "Reachability state: 404 on the description path (FR-MA06)."
  },

  "reachabilityMissingDescriptionSentence": "El backend está en línea, pero no publica su descripción de API: se generó sin springdoc-openapi. Sin esa descripción no se pueden descubrir las operaciones del backend.",
  "@reachabilityMissingDescriptionSentence": {
    "description": "Sentence of the missing-description state. FR-MA06: it names the cause and never offers a guessed route."
  },

  "reachabilityNotAnApiDescriptionLabel": "Sin descripción válida",
  "@reachabilityNotAnApiDescriptionLabel": {
    "description": "Reachability state: 2xx on the description path whose body is not a parseable OpenAPI document (FR-MA06). It has to fit the app-bar pill."
  },

  "reachabilityNotAnApiDescriptionSentence": "El backend respondió, pero el contenido de la ruta de la descripción no es un documento OpenAPI; por ejemplo, una página HTML. Sin esa descripción no se pueden descubrir las operaciones del backend.",
  "@reachabilityNotAnApiDescriptionSentence": {
    "description": "Sentence of the not-an-API-description state. FR-MA06: it names what the body actually is instead of reporting a status code, and it never falls back to guessing routes."
  },

  "reachabilityUnhealthyLabel": "Backend con error",
  "@reachabilityUnhealthyLabel": {
    "description": "Reachability state: any non-2xx other than 404 on the description path."
  },

  "reachabilityUnhealthySentence": "El backend respondió con el código {status} en la ruta de la descripción de la API.",
  "@reachabilityUnhealthySentence": {
    "description": "Sentence of the reachable-but-unhealthy state, naming the status the backend answered with.",
    "placeholders": {
      "status": {
        "type": "int"
      }
    }
  },

  "reachabilityUnhealthyNoStatusSentence": "El backend respondió con un error en la ruta de la descripción de la API.",
  "@reachabilityUnhealthyNoStatusSentence": {
    "description": "Fallback for the reachable-but-unhealthy state when no status is known, so the state always renders a sentence without interpolating an unknown number."
  },

  "reachabilityOfflineWithCacheLabel": "Sin conexión, con datos guardados",
  "@reachabilityOfflineWithCacheLabel": {
    "description": "Reachability state: the probe failed but a registry row exists for this profile. Cannot be reached before T4 persists a registry; the copy exists now so the state is complete."
  },

  "reachabilityOfflineWithCacheSentence": "No se pudo alcanzar el backend. Se trabaja con lo que se conoció en la última conexión.",
  "@reachabilityOfflineWithCacheSentence": {
    "description": "Sentence of the offline-with-cache state."
  },

  "reachabilityUnreachableLabel": "Sin conexión",
  "@reachabilityUnreachableLabel": {
    "description": "Reachability state: the probe failed and nothing is known about this backend."
  },

  "reachabilityUnreachableSentence": "No se pudo alcanzar el backend. Verifique que la dirección sea correcta y que el backend esté en marcha.",
  "@reachabilityUnreachableSentence": {
    "description": "Sentence of the unreachable state, naming the two things the user can act on."
  },

  "connectSuccessHeadline": "Backend conectado",
  "@connectSuccessHeadline": {
    "description": "Headline of the Connection Success state (UX spec, Pass 5), shown once the description was fetched and parsed."
  },

  "connectSuccessEntities": "Entidades descubiertas: {entities}",
  "@connectSuccessEntities": {
    "description": "Lists the entity names derived from the OpenAPI description. This is the discovery evidence the operator reads on the handset.",
    "placeholders": {
      "entities": {
        "type": "String"
      }
    }
  },

  "connectSuccessOperations": "{count, plural, =1{1 operación disponible} other{{count} operaciones disponibles}}",
  "@connectSuccessOperations": {
    "description": "Count of callable operations derived from the description (FR-MA03). FR-ME01: the number quantifies the noun in the same phrase, so a count of one needs the singular, and the ICU plural is what makes '1 operación disponible' and '2 operaciones disponibles' both correct. The screen renders connectSuccessNoOperations instead of a count of zero, so no zero branch is written.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },

  "connectSuccessNoOperations": "El backend respondió, pero no publica ninguna operación.",
  "@connectSuccessNoOperations": {
    "description": "Connection Success state for a description with no paths. UX spec Pass 6: an empty API is not an error and it gets its own sentence."
  },

  "connectSuccessCachedNote": "Entidades recordadas de la última conexión.",
  "@connectSuccessCachedNote": {
    "description": "Marks the entities as remembered rather than live when the registry in use is the cached one (FR-MA04). The UX spec's Connection table asks for exactly this distinction in its 'Offline with cache' row."
  },

  "connectRetry": "Reintentar",
  "@connectRetry": {
    "description": "Retry action of the Connection Partial state: it probes the same stored address again, without touching the address."
  },

  "registryChangedHeadline": "El registro cambió desde la última conexión",
  "@registryChangedHeadline": {
    "description": "Headline of the FR-MA07 change report. The UX spec keeps this element hidden until it happens and Primary when it does."
  },

  "registryChangedAdded": "Operaciones nuevas: {count}",
  "@registryChangedAdded": {
    "description": "Count of operations the new description declares and the previous one did not. The count phrasing avoids Spanish number agreement with a noun that would need singular and plural forms.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },

  "registryChangedRemoved": "Operaciones que ya no están: {count}",
  "@registryChangedRemoved": {
    "description": "Count of operations the previous description declared and the new one does not.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },

  "registryChangedSame": "El documento cambió, pero las operaciones son las mismas.",
  "@registryChangedSame": {
    "description": "Change report when the document hash changed but the callable operations are identical. It is said instead of showing an empty report, which would read as a failure."
  },

  "assistantCannotWork": "Todavía no hay nada con lo que trabajar. No se ha completado ninguna conexión y no hay datos guardados de una conexión anterior.",
  "@assistantCannotWork": {
    "description": "Pass 6, first launch offline with no cached registry: it has to be said plainly and no conversation surface may be shown, because one that can only fail is worse than none. It also covers a stored backend that cannot be reached with nothing remembered."
  },

  "assistantOpenConnect": "Conectar con un backend",
  "@assistantOpenConnect": {
    "description": "Action of the cannot-work state, so the plain statement is not a dead end. It opens the Connect screen."
  },

  "connectStart": "Empezar a hablar",
  "@connectStart": {
    "description": "Primary action of the Connection Success state: enter the conversation."
  },

  "connectChangeAddress": "Cambiar dirección",
  "@connectChangeAddress": {
    "description": "Secondary action of the Connection Success state, so the screen is never a dead end."
  },

  "entityListSeparator": ", ",
  "@entityListSeparator": {
    "description": "Separator between entity names in a running list built from the registry."
  },

  "entityListConjunction": " y ",
  "@entityListConjunction": {
    "description": "Conjunction before the last entity name in a running list built from the registry."
  },

  "assistantGreetingScope": "Hola, soy UMLive Voice. Puedo trabajar con {entities}.",
  "@assistantGreetingScope": {
    "description": "Assistant greeting stating its scope in domain terms, derived from the discovered schema (FR-MC07, UX spec Pass 4).",
    "placeholders": {
      "entities": {
        "type": "String"
      }
    }
  },

  "assistantGreetingScopeMore": "Hola, soy UMLive Voice. Puedo trabajar con {entities}, entre otras entidades.",
  "@assistantGreetingScopeMore": {
    "description": "Scope greeting when the backend exposes more entities than the three examples the UX spec allows.",
    "placeholders": {
      "entities": {
        "type": "String"
      }
    }
  },

  "assistantGreetingNoOperations": "Hola, soy UMLive Voice. El backend no publica ninguna operación, así que todavía no hay nada que pueda hacer.",
  "@assistantGreetingNoOperations": {
    "description": "Assistant greeting when the description declares no operations. UX spec Pass 6: state that the backend has no operations instead of showing an empty conversation surface."
  },

  "conversationResolvingCue": "Un momento…",
  "@conversationResolvingCue": {
    "description": "T15, UX Pass 5 (Resolving): spoken within 2 s of an utterance when a write is about to be sent (FR-MD03), so silence is never mistaken for failure while the operator is not looking at the screen. The ellipsis marks a wait that is genuinely unknown — the turn that follows is spoken when it settles. Neutral register, no tuteo or voseo."
  },

  "conversationPending": "Resolviendo la indicación…",
  "@conversationPending": {
