# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Generated localization sources (l10n.yaml + `generate: true`)
lib/l10n/app_localizations*.dart

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# The offline recognition model: about 126 MB on disk, bundled into the APK but
# never committed. It is fetched by hand with tool/fetch_sherpa_model.sh, which
# verifies the download against a recorded SHA-256 before extracting it here.
# The directory itself is kept so the fetch target exists in a fresh clone.
/assets/models/sherpa-es/*
!/assets/models/sherpa-es/.gitkeep

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Kotlin compiler session files, written under android/ during a Gradle build.
/android/.kotlin/
